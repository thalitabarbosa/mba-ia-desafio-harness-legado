{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs"],
      "project": ["scripts/**/*.mjs"],
      "ignore": ["blackbox/**", "kit-gates/**"]
    },
    "api": {
      "entry": ["test/integration/**/*.test.ts"],
      "project": ["src/**/*.ts", "prisma/**/*.ts", "test/**/*.ts"]
    },
    "web": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "include": ["files", "exports", "types", "nsExports", "nsTypes", "enumMembers", "duplicates", "dependencies", "devDependencies", "optionalPeerDependencies", "unlisted", "binaries", "unresolved"]
}
